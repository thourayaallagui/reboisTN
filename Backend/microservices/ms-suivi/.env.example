# The application does not load .env files automatically; export these values in your shell/container.
SERVER_PORT=8085

# suivi_db is the expected schema name. Create it manually before startup.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=suivi_db
MYSQL_USER=root
MYSQL_PASSWORD=

# Temporary development authentication. Replace the password with a local secret.
SUIVI_SECURITY_MODE=basic
SUIVI_SECURITY_USER=user
SUIVI_SECURITY_PASSWORD=user123

# Eureka URL for the current environment.
EUREKA_URL=http://localhost:8761/eureka

# Only required when SUIVI_SECURITY_MODE=keycloak; use the realm issuer agreed by the team.
KEYCLOAK_ISSUER_URI=
